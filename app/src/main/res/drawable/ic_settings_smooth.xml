<!--
  Cogwheel. Eight teeth drawn as four rotated pairs rather than one long path,
  so the shape stays readable and editable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,12 m-8.4,0 a8.4,8.4 0 1,0 16.8,0 a8.4,8.4 0 1,0 -16.8,0 M12,12 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />

    <group android:pivotX="12" android:pivotY="12" android:rotation="0">
        <path android:fillColor="#FFFFFF"
            android:pathData="M9.9,1.7 h4.2 v4.6 h-4.2 z M9.9,17.7 h4.2 v4.6 h-4.2 z" />
    </group>
    <group android:pivotX="12" android:pivotY="12" android:rotation="45">
        <path android:fillColor="#FFFFFF"
            android:pathData="M9.9,1.7 h4.2 v4.6 h-4.2 z M9.9,17.7 h4.2 v4.6 h-4.2 z" />
    </group>
    <group android:pivotX="12" android:pivotY="12" android:rotation="90">
        <path android:fillColor="#FFFFFF"
            android:pathData="M9.9,1.7 h4.2 v4.6 h-4.2 z M9.9,17.7 h4.2 v4.6 h-4.2 z" />
    </group>
    <group android:pivotX="12" android:pivotY="12" android:rotation="135">
        <path android:fillColor="#FFFFFF"
            android:pathData="M9.9,1.7 h4.2 v4.6 h-4.2 z M9.9,17.7 h4.2 v4.6 h-4.2 z" />
    </group>
</vector>
