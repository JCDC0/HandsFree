<?xml version="1.0" encoding="utf-8"?>
<!--
  Amber warning strip. Used by the assistant popup, which is always dark, so
  these values are literal rather than theme-aware. The debug screen's copy of
  the banner uses @color/hf_warning_* instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3A2E10" />
    <stroke
        android:width="1dp"
        android:color="#8D6E23" />
    <corners android:radius="8dp" />
</shape>
