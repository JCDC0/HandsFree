<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Debug UI palette. Every colour used by activity_main.xml and MainActivity
      lives here, with a dark counterpart in values-night/colors.xml.

      Do not put a raw #hex in the layout or in Kotlin. The screen used to
      hardcode them, which is why it stayed white on a phone set to dark mode.
      Add a name here and there, and the system picks the right one.
    -->
    <color name="hf_background">#F3EEE3</color>
    <color name="hf_card">#FFFDF7</color>

    <color name="hf_text_primary">#1A1A2E</color>
    <color name="hf_text_body">#333333</color>
    <color name="hf_text_label">#888888</color>
    <color name="hf_intent">#0066CC</color>

    <color name="hf_button_primary_bg">#1A1A2E</color>
    <color name="hf_button_primary_text">#FFFFFF</color>
    <color name="hf_button_neutral_bg">#EEEEEE</color>
    <color name="hf_button_neutral_text">#333333</color>
    <color name="hf_button_accent_bg">#E3F2FD</color>
    <color name="hf_button_accent_text">#1565C0</color>
    <color name="hf_button_danger_bg">#D32F2F</color>
    <color name="hf_button_danger_text">#FFFFFF</color>

    <!-- Call-sign toggle when on -->
    <color name="hf_toggle_on_bg">#C8E6C9</color>

    <!-- Warning banner: the command ran, but something outside the app will
         spoil the result. Amber, deliberately not the error red — a search with
         no connection is not a pipeline failure. -->
    <color name="hf_warning_bg">#FFF4D6</color>
    <color name="hf_warning_text">#7A5300</color>

    <!-- Transient status colours set from MainActivity -->
    <color name="hf_status_active">#1E88E5</color>
    <color name="hf_status_success">#2E7D32</color>
    <color name="hf_status_error">#D32F2F</color>

    <!-- Round activator buttons. Two states each, set from MainActivity: the
         start button is idle or listening, the call-sign button is off or on.
         Icon colours are named separately because the fill changes underneath
         them and a fixed icon colour fails contrast in one of the two. -->
    <color name="hf_circle_idle_bg">#3057C8</color>
    <color name="hf_circle_idle_icon">#FFFFFF</color>
    <color name="hf_circle_listening_bg">#E03131</color>
    <color name="hf_circle_listening_icon">#FFFFFF</color>
    <color name="hf_circle_off_bg">#E4DDCC</color>
    <color name="hf_circle_off_icon">#3A3A50</color>
    <color name="hf_circle_on_bg">#2F9E44</color>
    <color name="hf_circle_on_icon">#FFFFFF</color>

    <!-- Hairline between the three pipeline rows, which now share one card. -->
    <color name="hf_divider">#E4E4E8</color>

    <!-- Cogwheel and back arrow. Muted: they are how you leave the screen,
         not what you came to it for. -->
    <color name="hf_icon_muted">#6B6B7B</color>

    <!-- W3 pixel-art frame. Border and hard drop shadow for PixelFrameDrawable
         and PixelCircleDrawable. -->
    <color name="hf_px_border">#1B1B2F</color>
    <color name="hf_px_shadow">#BDB39C</color>
</resources>
