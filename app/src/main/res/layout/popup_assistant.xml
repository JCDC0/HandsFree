<?xml version="1.0" encoding="utf-8"?>
<!--
  The assistant popup, W3 pixel-art style. The frame is a PixelFrameDrawable
  set in OverlayService.showAssistantPopup(); bg_assistant_popup here is only
  the fallback. Colours are literal because this popup is always a dark panel
  over whatever app is open, whatever the system theme.

  Silkscreen for the status word, Pixelify Sans for the result line. The
  transcript stays in the system font at 18sp so it is readable at a glance.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_assistant_popup"
    android:paddingStart="22dp"
    android:paddingEnd="26dp"
    android:paddingTop="18dp"
    android:paddingBottom="22dp">

    <!-- Warning bar, first in the box so it is read first. Hidden unless a
         command ran into something outside the app's control (today: a web
         search with no connection). -->
    <TextView
        android:id="@+id/popup_warning_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/bg_warning"
        android:padding="10dp"
        android:text=""
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFD48A"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/popup_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listening..."
        android:textSize="14sp"
        android:fontFamily="@font/silkscreen"
        android:textColor="#9FB4FF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/popup_transcription_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="..."
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/popup_intent_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="#81C784"
        android:visibility="gone" />

</LinearLayout>
