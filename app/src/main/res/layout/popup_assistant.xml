<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="200dp"
    android:background="@drawable/bg_assistant_popup"
    android:elevation="8dp">

    <!-- Decorative HandsFree Watermark -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:text="🖐     🖐"
        android:textSize="80sp"
        android:textColor="#0AFFFFFF"
        android:gravity="center"
        android:includeFontPadding="false" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:text="HANDSFREE"
        android:textSize="40sp"
        android:textColor="#06FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="bottom">

        <TextView
            android:id="@+id/popup_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening..."
            android:textSize="14sp"
            android:textColor="#BDBDBD"
            android:textStyle="italic"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/popup_transcription_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/popup_intent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#81C784"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
