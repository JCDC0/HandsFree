<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen, W3 (1.6.0).

  The panel said the screen was too technical. The main screen now holds the
  app identity and the two activators, stacked vertically, and nothing else.
  Status, Transcribed, Translated and Detected Intent moved into a drawer on the
  start edge headed "Debug Screen", opened from the button at the top left or
  by swiping from the left edge. Settings stay behind the cogwheel: the drawer
  is for reading pipeline state, settings are for changing things.

  Every view id from 1.5.x is kept, so MainActivity's findViewById calls still
  resolve. Frames and circles are pixel-art drawables set from MainActivity
  (util/PixelDrawables.kt); colours come from @color/hf_* with night variants.

  Fonts: Silkscreen for the title and small labels, Pixelify Sans for
  captions and status. Both are SIL Open Font License, bundled in res/font,
  licences in assets/licenses. The transcript and translation stay in the
  system font: pixel fonts at body size are hard to read, and the study now
  recruits low-vision participants.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_background">

    <ScrollView
        android:id="@+id/root_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/hf_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/debug_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu_pixel"
                    android:background="@drawable/icon_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:tint="@color/hf_text_primary"
                    android:contentDescription="" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/settings_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/icon_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:tint="@color/hf_text_primary"
                    android:contentDescription="" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:gravity="center"
                android:textSize="34sp"
                android:fontFamily="@font/silkscreen"
                android:textColor="@color/hf_text_primary" />

            <TextView
                android:id="@+id/subtitle_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="15sp"
                android:fontFamily="@font/pixelify_sans"
                android:textColor="@color/hf_text_label" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <FrameLayout
                android:id="@+id/start_button"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="">

                <ImageView
                    android:id="@+id/start_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:importantForAccessibility="no"
                    android:contentDescription="" />
            </FrameLayout>

            <TextView
                android:id="@+id/start_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="@font/pixelify_sans"
                android:textColor="@color/hf_text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <FrameLayout
                android:id="@+id/wake_word_button"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="">

                <ImageView
                    android:id="@+id/wake_word_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call_sign"
                    android:importantForAccessibility="no"
                    android:contentDescription="" />
            </FrameLayout>

            <TextView
                android:id="@+id/wake_word_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="@font/pixelify_sans"
                android:textColor="@color/hf_text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/debug_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/hf_background">

        <ScrollView
            android:id="@+id/debug_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/debug_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="20sp"
                    android:fontFamily="@font/silkscreen"
                    android:textColor="@color/hf_text_primary"
                    android:layout_marginBottom="16dp" />

                <!-- Warning banner: hidden unless a command ran into something
                     outside the app's control, today only a web search with no
                     connection. -->
                <FrameLayout
                    android:id="@+id/warning_card"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/warning_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/hf_warning_text" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/status_card"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/status_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:fontFamily="@font/silkscreen"
                            android:textColor="@color/hf_text_label"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="15sp"
                            android:fontFamily="@font/pixelify_sans"
                            android:lineSpacingExtra="2sp"
                            android:textColor="@color/hf_text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pipeline_card"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/transcribed_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:fontFamily="@font/silkscreen"
                        android:textColor="@color/hf_text_label"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/transcribed_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="@color/hf_text_body" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/hf_divider" />

                    <TextView
                        android:id="@+id/translated_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:fontFamily="@font/silkscreen"
                        android:textColor="@color/hf_text_label"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/translated_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="@color/hf_text_body" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/hf_divider" />

                    <TextView
                        android:id="@+id/intent_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:fontFamily="@font/silkscreen"
                        android:textColor="@color/hf_text_label"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/intent_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:text=""
                        android:textSize="16sp"
                        android:fontFamily="@font/pixelify_sans"
                        android:textColor="@color/hf_intent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
