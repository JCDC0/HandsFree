<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ HandsFree"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Voice Overlay"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HandsFree ready"
                    android:textSize="16sp"
                    android:textColor="#1A1A2E"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Transcription Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NARINIG  (Transcribed)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/transcribed_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Translation Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SALIN  (Translated)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/translated_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Intent Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECTED INTENT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/intent_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#0066CC"
                    android:textStyle="bold"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Buttons -->
        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▶  Start Mic &amp; VOSK"
            android:textSize="15sp"
            android:backgroundTint="#1A1A2E"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/model_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Model: EN"
            android:textSize="14sp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/perm_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚙  Open Accessibility Settings"
            android:textSize="14sp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/show_log_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📋 Show Last Log"
            android:textSize="14sp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#333333" />

    </LinearLayout>
</ScrollView>