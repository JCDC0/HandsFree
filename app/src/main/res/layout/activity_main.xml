<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug UI. Colours come from @color/hf_* so the screen follows the system
  light/dark setting — see values/colors.xml and values-night/colors.xml.
  Do not put a raw #hex back in here.

  1.5.2: this screen holds the pipeline and the two activators and nothing
  else. Everything a tester touches once (mic window, permissions, logs,
  export, how-to, language) is behind the cogwheel in activity_settings.xml.
  A tester stares at this screen while speaking; anything that is not the
  transcript or a way to start listening was competing for that attention.

  No emoji anywhere on this screen. The two activators carry vector glyphs
  (ic_mic, ic_call_sign), which tint with the button state; an emoji cannot.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/hf_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Title bar. The cogwheel is the only way off this screen, so it sits
             at the top right where a thumb reaches it and where every other
             Android app puts it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/hf_text_primary" />

                <TextView
                    android:id="@+id/subtitle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/hf_text_label" />
            </LinearLayout>

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/icon_button"
                android:clickable="true"
                android:focusable="true"
                android:tint="@color/hf_icon_muted"
                android:contentDescription="" />
        </LinearLayout>

        <!-- Warning banner. Sits above the status card so it is the first thing
             read, and is hidden unless a command ran into something outside the
             app's control — today only a web search with no connection. Amber,
             not the error red: the pipeline did its job. -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:id="@+id/warning_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/hf_warning_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text=""
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/hf_warning_text" />
        </androidx.cardview.widget.CardView>

        <!-- Status card. The dot on the left is tinted from MainActivity and is
             the fastest read on the screen: grey idle, blue listening, green
             ran, red failed. -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="1dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/status_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/hf_text_label"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:lineSpacingExtra="2sp"
                        android:textColor="@color/hf_text_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- One card, three rows: what was heard, what it normalised to, what
             it matched. They describe a single utterance, so three separate
             cards made one event look like three and pushed the buttons off
             the bottom of the screen. -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="1dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/transcribed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text=""
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/transcribed_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:minHeight="44dp"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/hf_text_body"
                    android:gravity="top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hf_divider" />

                <TextView
                    android:id="@+id/translated_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text=""
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/translated_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:minHeight="44dp"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/hf_text_body"
                    android:gravity="top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hf_divider" />

                <TextView
                    android:id="@+id/intent_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text=""
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/intent_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:minHeight="28dp"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/hf_intent"
                    android:textStyle="bold"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- The two activators. Round and large because the person using this
             app may not be able to aim: a 120dp circle is roughly three times
             the area of the 52dp bar it replaces, and there are now two
             targets on the screen instead of nine.

             The label is under the circle, not in it. "Magsimulang makinig"
             does not fit inside a circle at a readable size, and shrinking the
             circle to fit the text would undo the point of the change. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/start_button"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/circle_button"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="">

                    <ImageView
                        android:id="@+id/start_icon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:importantForAccessibility="no"
                        android:contentDescription="" />
                </FrameLayout>

                <TextView
                    android:id="@+id/start_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/wake_word_button"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/circle_button"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="">

                    <ImageView
                        android:id="@+id/wake_word_icon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call_sign"
                        android:importantForAccessibility="no"
                        android:contentDescription="" />
                </FrameLayout>

                <TextView
                    android:id="@+id/wake_word_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
