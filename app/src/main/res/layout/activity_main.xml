<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug UI. Colours come from @color/hf_* so the screen follows the system
  light/dark setting — see values/colors.xml and values-night/colors.xml.
  Do not put a raw #hex back in here.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ HandsFree"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/hf_text_primary"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Voice Overlay"
            android:textSize="13sp"
            android:textColor="@color/hf_text_label"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Warning banner. Sits above the status card so it is the first thing
             read, and is hidden unless a command ran into something outside the
             app's control — today only a web search with no connection. Amber,
             not the error red: the pipeline did its job. -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:id="@+id/warning_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="2dp"
            card_view:cardBackgroundColor="@color/hf_warning_bg"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text=""
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/hf_warning_text" />
        </androidx.cardview.widget.CardView>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HandsFree ready"
                    android:textSize="16sp"
                    android:textColor="@color/hf_text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Transcription Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NARINIG  (Transcribed)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/transcribed_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="@color/hf_text_body"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Translation Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SALIN  (Translated)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/translated_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="@color/hf_text_body"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Intent Card -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="@color/hf_card"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECTED INTENT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hf_text_label"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/intent_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="@color/hf_intent"
                    android:textStyle="bold"
                    android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Buttons. wrap_content + minHeight, never a fixed height: a label
             that wraps to two lines is clipped by a fixed 52dp button. -->
        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="▶  Start Listening"
            android:textSize="15sp"
            android:backgroundTint="@color/hf_button_primary_bg"
            android:textColor="@color/hf_button_primary_text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/wake_word_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="👂 Call sign: OFF"
            android:textSize="14sp"
            android:backgroundTint="@color/hf_button_neutral_bg"
            android:textColor="@color/hf_button_neutral_text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/perm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="⚙  Accessibility Settings"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_neutral_bg"
            android:textColor="@color/hf_button_neutral_text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/show_history_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="📜 Narinig, Salin &amp; Intent Log"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_accent_bg"
            android:textColor="@color/hf_button_accent_text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/show_log_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="📋 Show System Log"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_neutral_bg"
            android:textColor="@color/hf_button_neutral_text"
            android:layout_marginBottom="10dp" />

        <!-- The tester's route back to us: writes the log to a file and hands it
             to the share sheet, for the Google Form. Accent-coloured because on
             a testing build it is the second most important button here. -->
        <Button
            android:id="@+id/export_log_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="📤 Export Log for Google Form"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_accent_bg"
            android:textColor="@color/hf_button_accent_text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/how_to_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="❓ Paano gamitin / How to use"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_neutral_bg"
            android:textColor="@color/hf_button_neutral_text"
            android:layout_marginBottom="10dp" />

        <!-- Label is set from Kotlin — it names the language you would switch
             TO, so hardcoding either half here would be wrong half the time. -->
        <Button
            android:id="@+id/language_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="🌐 Wika / Language"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:backgroundTint="@color/hf_button_neutral_bg"
            android:textColor="@color/hf_button_neutral_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🙌"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:paddingBottom="18dp" />

    </LinearLayout>
</ScrollView>
