# Local editor / IDE caches (VS Code, Kotlin daemon)
.vscode/
.kotlin/

# VOSK model files — too large for Git (>100MB limit)
# Each member must download manually (see README.md)
app/src/main/assets/vosk-model-small-en-us-0.15/
app/src/main/assets/vosk-model-tl-ph-generic-0.6/

# Whisper ONNX export — bundled at build time, not committed
app/src/main/assets/whisper/

# The openWakeWord KWS models (~3.6 MB total) ARE committed — they are small
# enough for git, and leaving them out meant the call sign silently did nothing
# on a fresh clone. Whisper's stay out: decoder.onnx alone is 109 MB and GitHub
# rejects anything over 100 MB.

# Docker build output (docker build --target apk --output out .)
/out/
